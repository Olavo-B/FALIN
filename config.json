  "software": {
    "redundance": 1,
    "epochs": 200,
    "batch_size": 64,
    "models_to_run": ["FalinCNN"],
    "img_strategy": "gaf",
    "descriptor_size": 128,
    "target_image_size": 96,

    "adaptive_learning_rate": {
      "_comment": "n_samples < small_dataset_threshold -> small_lr; < medium_dataset_threshold -> medium_lr; else large_lr",
      "small_dataset_threshold": 200,
      "medium_dataset_threshold": 1000,
      "small_lr": 5e-5,
      "medium_lr": 1e-4,
      "large_lr": 3e-4
    },

    "adaptive_patience": {
      "_comment": "scheduler/early-stop patience = max(min_value, num_batches / divisor)",
      "scheduler_min": 20,
      "scheduler_batch_divisor": 5,
      "early_stop_min": 30,
      "early_stop_batch_divisor": 3
    },

    "xgboost": {
      "_comment": "Kept for the future/extended paper - XGBoost is deferred from the current SBESC submission but the code path still exists.",
      "n_estimators": 50,
      "max_depth": 6,
      "learning_rate": 0.1
    }
  },

  "qat": {
    "epochs": 30,
    "learning_rate": 1e-5,
    "scheduler_patience": 5,
    "early_stop_patience": 10,
    "batch_size": 64,
    "weight_bit_width": 8,
    "act_bit_width": 8
  },

  "hardware": {
    "shift": 20,
    "num_testbench_samples": 5,
    "gaf_size": 96,
    "data_width": 8
  }
}
