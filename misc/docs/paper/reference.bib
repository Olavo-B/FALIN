@article{https://doi.org/10.1002/cpe.70744,
author = {Barros, Olavo and Freitas, Isabela and Pereira, Pedro H. and Neto, Walter de B. and Alcolea, Adrián and Villarroya-Gaudó, María and Resano, Javier and Nacif, José Augusto M. and Ferreira, Ricardo},
title = {Rethinking Per-Thread Computation for Machine Learning Design Exploration: A Work-Efficient GPU Strategy for K-Means and XGBoost},
journal = {Concurrency and Computation: Practice and Experience},
volume = {38},
number = {11},
pages = {e70744},
keywords = {dimensionality reduction, GPU, K-means, pruning, XGBoost},
doi = {https://doi.org/10.1002/cpe.70744},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/cpe.70744},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/cpe.70744},
abstract = {ABSTRACT This paper presents novel GPU implementation strategies that effectively exploit the available parallelism, based on the “more work per thread” approach, for three machine learning design exploration tasks: Multiple K-means evaluation, dimensionality reduction through parallel K-means encoding for XGBoost trees, and XGBoost tree pruning optimization. Our experimental results demonstrate significant performance improvements across all implementations. For multiple K-means evaluations, we achieve substantial speedups of 20\$\$ \times \$\$ to 70\$\$ \times \$\$ compared to Nvidia's cuML library. The dimensionality reduction approach, which uses parallel K-means encoding, achieves encoding reductions of up to two orders of magnitude while preserving classification accuracy within 1\%–2\% of the original performance. Additionally, we propose a Gini coefficient-based design exploration optimization that greatly reduces the number of models to be trained during the design space optimal search, achieving a 400\$\$ \times \$\$ speedup. Furthermore, a parallel post-pruning evaluation framework for XGBoost demonstrates the ability to remove up to 50\% of tree nodes without significant loss of accuracy.},
year = {2026}
}

